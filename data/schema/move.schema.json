{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "move.schema.json",
  "title": "Move file",
  "description": "data/characters/<character>/moves/<id>.json. Editor aid only: Sim.Data's validator is authoritative and also checks cross-file rules (cancel targets exist, boxes inside the move's frames). Frames are 1-based and inclusive. Boxes face right: x forward and y up from the fighter's origin, in subpixels (1 px = 1000).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "category", "boxes"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id", "description": "Must equal the file name without .json." },
    "category": {
      "enum": ["basic", "normal", "special", "super", "throw"],
      "description": "basic = entered by the state machine (idle, walk, hitstun…): uses duration, no input, no hit boxes. Others use frameData, input and usableIn."
    },
    "duration": { "$ref": "#/$defs/frames", "description": "Basic moves only: length of one loop." },
    "frameData": {
      "description": "Not for basic moves. Startup counts the first active frame (startup 5 = active from frame 5); total = startup - 1 + active + recovery.",
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "active", "recovery"],
      "properties": {
        "startup": { "$ref": "#/$defs/frames" },
        "active": { "$ref": "#/$defs/frames" },
        "recovery": { "type": "integer", "minimum": 0, "maximum": 999 }
      }
    },
    "usableIn": { "enum": ["ground", "air"], "description": "Not for basic moves." },
    "input": {
      "description": "Not for basic moves.",
      "type": "object",
      "additionalProperties": false,
      "required": ["motion", "button"],
      "properties": {
        "motion": { "type": "string", "pattern": "^[1-9]{1,8}$", "description": "Numpad notation: \"5\" none, \"2\" down, \"236\" quarter circle forward." },
        "button": { "$ref": "#/$defs/id", "description": "A button id from the button set (ADR-0010)." }
      }
    },
    "boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "firstFrame", "lastFrame", "x", "y", "width", "height"],
        "properties": {
          "kind": { "enum": ["hurt", "hit", "push", "throw"], "description": "hit and throw boxes must stay within the active frames." },
          "firstFrame": { "$ref": "#/$defs/frames" },
          "lastFrame": { "$ref": "#/$defs/frames" },
          "x": { "$ref": "#/$defs/coordinate", "description": "Minimum corner, forward of the origin." },
          "y": { "$ref": "#/$defs/coordinate", "description": "Minimum corner, above the origin." },
          "width": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "height": { "type": "integer", "minimum": 1, "maximum": 1000000 }
        }
      }
    },
    "cancels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["firstFrame", "lastFrame", "on"],
        "description": "Needs at least one target in into or intoCategories.",
        "properties": {
          "firstFrame": { "$ref": "#/$defs/frames" },
          "lastFrame": { "$ref": "#/$defs/frames" },
          "on": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["hit", "block", "whiff"] } },
          "into": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" }, "description": "Move ids from the character's move list." },
          "intoCategories": { "type": "array", "uniqueItems": true, "items": { "enum": ["normal", "special", "super", "throw"] } }
        }
      }
    },
    "velocity": {
      "description": "The move's own velocity, x forward and y up in subpixels per frame. On the frames a range covers it replaces the fighter's velocity and gravity doesn't apply (dashes, backdashes, air dashes, lunges). Ranges in frame order, not overlapping, inside the move's frames.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["firstFrame", "lastFrame", "x"],
        "properties": {
          "firstFrame": { "$ref": "#/$defs/frames" },
          "lastFrame": { "$ref": "#/$defs/frames" },
          "x": { "$ref": "#/$defs/coordinate" },
          "y": { "$ref": "#/$defs/coordinate", "description": "Default 0." }
        }
      }
    },
    "invulnerable": {
      "description": "Frames on which the fighter can't be hit or thrown (backdash, reversals). Inside the move's frames.",
      "type": "object",
      "additionalProperties": false,
      "required": ["firstFrame", "lastFrame"],
      "properties": {
        "firstFrame": { "$ref": "#/$defs/frames" },
        "lastFrame": { "$ref": "#/$defs/frames" }
      }
    },
    "hit": {
      "description": "Required exactly when the move has a hit or throw box.",
      "type": "object",
      "additionalProperties": false,
      "required": ["damage", "guard", "hitstun", "blockstun", "hitstop", "pushback"],
      "properties": {
        "damage": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "chipDamage": { "type": "integer", "minimum": 0, "description": "Default 0; at most damage." },
        "guard": { "enum": ["mid", "low", "overhead", "unblockable"] },
        "hitstun": { "type": "integer", "minimum": 0, "maximum": 999 },
        "blockstun": { "type": "integer", "minimum": 0, "maximum": 999 },
        "hitstop": { "type": "integer", "minimum": 0, "maximum": 999 },
        "pushback": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "reaction": { "enum": ["hitstun", "knockdown"], "description": "Default hitstun." }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "category": { "const": "basic" } } },
      "then": { "required": ["duration"], "not": { "anyOf": [{ "required": ["frameData"] }, { "required": ["input"] }, { "required": ["usableIn"] }] } },
      "else": { "required": ["frameData", "input", "usableIn"], "not": { "required": ["duration"] } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$", "maxLength": 32 },
    "frames": { "type": "integer", "minimum": 1, "maximum": 999 },
    "coordinate": { "type": "integer", "minimum": -1000000, "maximum": 1000000 }
  }
}
