// Built-in controller layouts (player settings, ARCHITECTURE.md §6), embedded in the game. The first preset of each
// kind is that kind's default: a device without a layout of its own uses it, and "Reset to default" goes back to it.
// The player's own layouts are saved per device in user://controls.json (ADR-0047); edit them in Options → Controls.
// Inputs: up, down, left, right and the button ids of data/input/buttons.json; menu: confirm and back. Each lists the
// controls bound to it. Keys: Godot Key names, by physical position (W, Up, Space, Kp4). Joypad: Godot JoyButton
// names (A, X, DpadLeft, RightShoulder, ...) or TriggerLeft / TriggerRight. Opposite directions held together are
// both sent: the logic applies the fixed SOCD rule (ADR-0002).
{
  "schemaVersion": 2,
  "presets": [
    {
      "id": "keyboard_default", "name": "MENU_CONTROLS_PRESET_KEYBOARD", "kind": "keyboard",
      "profile": {
        "bindings": {
          "up": ["W"], "down": ["S"], "left": ["A"], "right": ["D"],
          // P is special + C at once: the 236C fireball by its shortcut, in one key for laptops.
          "a": ["U"], "b": ["I"], "c": ["J", "P"], "d": ["K"], "special": ["O", "P"], "dash": ["L"]
        },
        "menu": { "confirm": ["Enter", "KpEnter", "Space"], "back": ["Escape", "Backspace"] }
      }
    },
    {
      "id": "keyboard_arrows", "name": "MENU_CONTROLS_PRESET_KEYBOARD_ARROWS", "kind": "keyboard",
      "profile": {
        "bindings": {
          "up": ["Up"], "down": ["Down"], "left": ["Left"], "right": ["Right"],
          "a": ["Kp4"], "b": ["Kp5"], "c": ["Kp1"], "d": ["Kp2"], "special": ["Kp6"], "dash": ["Kp3"]
        },
        "menu": { "confirm": ["Enter", "KpEnter", "Space"], "back": ["Escape", "Backspace"] }
      }
    },
    {
      // Leverless boards in keyboard mode: up on the thumb, like a hitbox.
      "id": "keyboard_leverless", "name": "MENU_CONTROLS_PRESET_KEYBOARD_LEVERLESS", "kind": "keyboard",
      "profile": {
        "bindings": {
          "up": ["Space"], "down": ["S"], "left": ["A"], "right": ["D"],
          "a": ["U"], "b": ["I"], "c": ["O"], "d": ["P"], "special": ["J"], "dash": ["K"]
        },
        "menu": { "confirm": ["Enter", "KpEnter"], "back": ["Escape", "Backspace"] }
      }
    },
    {
      "id": "pad_classic", "name": "MENU_CONTROLS_PRESET_PAD", "kind": "joypad",
      "profile": {
        "leftStick": true, "stickDeadzone": 0.5, "triggerThreshold": 0.5,
        "bindings": {
          "up": ["DpadUp"], "down": ["DpadDown"], "left": ["DpadLeft"], "right": ["DpadRight"],
          "a": ["X"], "b": ["Y"], "c": ["B"], "d": ["A"], "special": ["RightShoulder"], "dash": ["TriggerRight"]
        },
        "menu": { "confirm": ["A"], "back": ["B"] }
      }
    },
    {
      // Leverless boards in pad mode: top row X Y RB LB, bottom row A B RT LT; the stick is left off so a board in
      // stick mode doesn't send directions twice.
      "id": "pad_leverless", "name": "MENU_CONTROLS_PRESET_PAD_LEVERLESS", "kind": "joypad",
      "profile": {
        "leftStick": false, "stickDeadzone": 0.5, "triggerThreshold": 0.5,
        "bindings": {
          "up": ["DpadUp"], "down": ["DpadDown"], "left": ["DpadLeft"], "right": ["DpadRight"],
          "a": ["X"], "b": ["Y"], "c": ["RightShoulder"], "d": ["LeftShoulder"], "special": ["A"], "dash": ["B"]
        },
        "menu": { "confirm": ["A"], "back": ["B"] }
      }
    }
  ]
}
