{
  // Test setup: Mixamo FBX files in game/TestModel (committed by Lukas' choice). Mixamo models face +Z, so turn 90°.
  // Contact frames: measured peak limb reach in each clip (5A 34, 5B 24, 5C 38, 5D 34), contact just before it.
  "artVersion": 1,
  "art": "model",
  "model": "res://TestModel/MainModel.fbx",
  "turnDegrees": 90,
  // The Mixamo model's idle stance is ~1.2 m; ×1.4 makes it 1.7 m, the height of testman's 120 px idle hurtbox.
  "scale": 1.4,
  // Look settings: basic moves fade in over 4 frames, a side switch turns over 6, poses every frame (2 = on 2s).
  "crossfadeFrames": 4,
  "turnFrames": 6,
  "holdFrames": 1,
  // Played from the frame of the KO on, whatever the logic does meanwhile; it ends lying down.
  "knockOut": { "file": "res://TestModel/Dying.fbx", "clip": "mixamo_com", "inPlace": true },
  "animations": {
    "idle": { "file": "res://TestModel/Idle.fbx", "clip": "mixamo_com", "loop": true, "inPlace": true },
    // Speeds: logic walk/run speed over the clip's own travel (walk 0.057/0.0216 m per frame, run 0.129/0.0551, back 0.046/0.0146).
    "walk_forward": { "file": "res://TestModel/Walking.fbx", "clip": "mixamo_com", "loop": true, "inPlace": true, "speed": 2.64 },
    "walk_back": { "file": "res://TestModel/Walking Backwards.fbx", "clip": "mixamo_com", "loop": true, "inPlace": true, "speed": 3.1 },
    // Backdash: the walk-back cycle's first step (clip 0-26) in the 6 fast frames, then held there; not looping, so it holds.
    "backdash": { "file": "res://TestModel/Standing Walk Back.fbx", "clip": "mixamo_com", "inPlace": true, "clipTo": 26, "speed": 4.33 },
    "dash": { "file": "res://TestModel/Run.fbx", "clip": "mixamo_com", "loop": true, "inPlace": true, "speed": 2.33 },
    "crouch": { "file": "res://TestModel/Crouch.fbx", "clip": "mixamo_com", "loop": true, "inPlace": true },
    // Jumping.fbx measured by hip height: wind-up to 28 (takeoff), airborne to 66 (touchdown), settled by 96.
    "prejump": { "file": "res://TestModel/Jumping.fbx", "clip": "mixamo_com", "inPlace": true, "clipFrom": 8, "clipTo": 28, "fit": true, "crossfadeFrames": 0 },
    "jump": { "file": "res://TestModel/Jumping.fbx", "clip": "mixamo_com", "inPlace": true, "holdHeight": true, "clipFrom": 28, "clipTo": 66 },
    "landing": { "file": "res://TestModel/Jumping.fbx", "clip": "mixamo_com", "inPlace": true, "clipFrom": 66, "clipTo": 96, "fit": true, "crossfadeFrames": 0 },
    "wake_up": { "file": "res://TestModel/Crouch To Standing.fbx", "clip": "mixamo_com", "inPlace": true },
    "blockstun": { "file": "res://TestModel/Blocking.fbx", "clip": "mixamo_com", "inPlace": true },
    "crouch_blockstun": { "file": "res://TestModel/Blocking.fbx", "clip": "mixamo_com", "inPlace": true },
    "hitstun": { "file": "res://TestModel/GettingHit.fbx", "clip": "mixamo_com", "inPlace": true },
    "crouch_hitstun": { "file": "res://TestModel/GettingHit.fbx", "clip": "mixamo_com", "inPlace": true },
    "air_hitstun": { "file": "res://TestModel/GettingHit.fbx", "clip": "mixamo_com", "inPlace": true },
    "5a": { "file": "res://TestModel/AttackA.fbx", "clip": "mixamo_com", "inPlace": true, "activeFrom": 32, "recoveryFrom": 36 },
    "5b": { "file": "res://TestModel/AttackB.fbx", "clip": "mixamo_com", "inPlace": true, "activeFrom": 22, "recoveryFrom": 27 },
    "5c": { "file": "res://TestModel/AttackC.fbx", "clip": "mixamo_com", "inPlace": true, "activeFrom": 35, "recoveryFrom": 42 },
    "5d": { "file": "res://TestModel/AttackD.fbx", "clip": "mixamo_com", "inPlace": true, "activeFrom": 31, "recoveryFrom": 38 },
    // SpecialMoveFireball.fbx (162 frames) from frame 15, its last idle-like frame; hands overhead 30-57, pushed out
    // at 66, fully out 72-96, back by 150. Contacts relative to clipFrom: the push (66) and arms out (72).
    "236c": { "file": "res://TestModel/SpecialMoveFireball.fbx", "clip": "mixamo_com", "inPlace": true, "clipFrom": 15, "clipTo": 150, "activeFrom": 51, "recoveryFrom": 57 }
  },
  // How each projectile-throwing move's projectiles are drawn (ProjectileEffects): in flight, the startup charge at
  // the spawn point, and the impact where it hits, is blocked, clashes or runs out.
  "projectiles": {
    "236c": { "flight": "dark_fireball", "charge": "dark_fireball_charge", "impact": "dark_fireball_impact" }
  },
  // "Crouch To Standing" both ways: forward to stand up, reversed to crouch down. Looks only; the logic snaps.
  "transitions": [
    { "from": ["crouch"], "to": ["idle", "walk_forward", "walk_back"], "file": "res://TestModel/Crouch To Standing.fbx", "clip": "mixamo_com", "frames": 8, "inPlace": true },
    { "from": ["idle", "walk_forward", "walk_back"], "to": ["crouch"], "file": "res://TestModel/Crouch To Standing.fbx", "clip": "mixamo_com", "frames": 6, "reverse": true, "inPlace": true }
  ]
}
