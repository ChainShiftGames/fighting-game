{
  // Test setup: the Tripo test model (game/Assets/Characters/tripo_elf, Tripo's rigged FBX through
  // tools/Blender/tripo_to_glb.py) with Quaternius' Universal Animation Library 1 and 2 (CC0, game/Assets/Animations),
  // retargeted at import through Godot's humanoid bone maps. Tripo models are 1 m tall and face +Z: scale to 1.75 m,
  // the height of testman's 120 px idle hurtbox, and turn 90°.
  // Godot drops a clip's "_Loop" suffix on import (and makes it loop). The pack has few fighting moves, so several
  // moves borrow the nearest clip; see game/Assets/Animations/README.md for the measurements.
  // Contact frames: measured peak hand or foot reach in each clip, contact just before it.
  "artVersion": 1,
  "art": "model",
  "model": "res://Assets/Characters/tripo_elf/tripo_elf.glb",
  "turnDegrees": 90,
  "scale": 1.75,
  // Models to compare on the same clips, switched with the debug panel's "Switch fighter model" (F1): the Tripo
  // armor model (50 parts joined, textures atlased by tripo_to_glb.py) and the VRoid model.
  "otherModels": [
    { "model": "res://Assets/Characters/tripo_armor/tripo_armor.glb", "scale": 1.67, "turnDegrees": 90 },
    { "model": "res://Assets/Characters/vroid_test/vroid_test.glb", "scale": 1.0, "turnDegrees": 90 }
  ],
  // Look settings: basic moves fade in over 4 frames (hit and block reactions snap in, as attacks do), a side switch
  // turns over 6, poses on 2s (the hand-animated, Guilty Gear look; 1 = every frame), and she stands turned 30° toward
  // the camera so her face and chest show (developer setting: tune it in the debug panel, F1).
  "crossfadeFrames": 4,
  "turnFrames": 6,
  "cameraTurnDegrees": 30,
  "holdFrames": 2,
  // Played from the frame of the KO on, whatever the logic does meanwhile; it ends lying down.
  "knockOut": { "file": "res://Assets/Animations/ual1_standard.glb", "clip": "Death01" },
  "animations": {
    "idle": { "file": "res://Assets/Animations/ual1_standard.glb", "clip": "Idle", "loop": true },
    // Speeds: logic speed over the clip's own foot speed (walk 0.057/0.0423 jog, back 0.046/0.0155 walk, run 0.129/0.0597 m per frame).
    "walk_forward": { "file": "res://Assets/Animations/ual1_standard.glb", "clip": "Jog_Fwd", "loop": true, "speed": 1.35 },
    // No walk back in the pack: the walk played backwards.
    "walk_back": { "file": "res://Assets/Animations/ual1_standard.glb", "clip": "Walk", "loop": true, "reverse": true, "speed": 3.0 },
    "dash": { "file": "res://Assets/Animations/ual1_standard.glb", "clip": "Sprint", "loop": true, "speed": 2.16 },
    // Backdash: half a backwards walk cycle, fast, then held.
    "backdash": { "file": "res://Assets/Animations/ual1_standard.glb", "clip": "Walk", "reverse": true, "loop": false, "clipTo": 40, "speed": 4.0 },
    "air_dash": { "file": "res://Assets/Animations/ual1_standard.glb", "clip": "Sprint", "loop": true, "speed": 2.0 },
    "air_backdash": { "file": "res://Assets/Animations/ual1_standard.glb", "clip": "Walk", "reverse": true, "loop": false, "clipTo": 40, "speed": 4.0 },
    "crouch": { "file": "res://Assets/Animations/ual1_standard.glb", "clip": "Crouch_Idle", "loop": true },
    // NinjaJump: hips lowest at 0, up by 14 (takeoff); landing lowest at 12, standing by 24.
    "prejump": { "file": "res://Assets/Animations/ual2_standard.glb", "clip": "NinjaJump_Start", "clipTo": 14, "fit": true, "crossfadeFrames": 0 },
    "jump": { "file": "res://Assets/Animations/ual1_standard.glb", "clip": "Jump", "loop": true },
    "landing": { "file": "res://Assets/Animations/ual2_standard.glb", "clip": "NinjaJump_Land", "clipTo": 24, "fit": true, "crossfadeFrames": 0 },
    "knockdown": { "file": "res://Assets/Animations/ual2_standard.glb", "clip": "Hit_Knockback", "fit": true },
    "wake_up": { "file": "res://Assets/Animations/ual2_standard.glb", "clip": "LayToIdle", "fit": true },
    "thrown": { "file": "res://Assets/Animations/ual2_standard.glb", "clip": "Hit_Knockback", "fit": true },
    "throw_tech": { "file": "res://Assets/Animations/ual1_standard.glb", "clip": "Hit_Chest", "fit": true },
    // Guard up by 10, lowest at 22; held there.
    "blockstun": { "file": "res://Assets/Animations/ual2_standard.glb", "clip": "Sword_Block", "clipTo": 22 },
    "air_blockstun": { "file": "res://Assets/Animations/ual2_standard.glb", "clip": "Sword_Block", "clipTo": 22 },
    "hitstun": { "file": "res://Assets/Animations/ual1_standard.glb", "clip": "Hit_Chest" },
    "air_hitstun": { "file": "res://Assets/Animations/ual2_standard.glb", "clip": "Hit_Knockback", "clipTo": 20 },
    // No crouching hit or block clips: she stays crouched.
    "crouch_blockstun": { "file": "res://Assets/Animations/ual1_standard.glb", "clip": "Crouch_Idle", "loop": true },
    "crouch_hitstun": { "file": "res://Assets/Animations/ual1_standard.glb", "clip": "Crouch_Idle", "loop": true },
    // Peak reach: jab 12, cross 18, slash 14, overhand 23, low hook 16, crouching slash 15, slide 16, air chop 26.
    "5a": { "file": "res://Assets/Animations/ual1_standard.glb", "clip": "Punch_Jab", "activeFrom": 10, "recoveryFrom": 14 },
    "5b": { "file": "res://Assets/Animations/ual1_standard.glb", "clip": "Punch_Cross", "activeFrom": 15, "recoveryFrom": 20 },
    "5c": { "file": "res://Assets/Animations/ual2_standard.glb", "clip": "Sword_Regular_A", "activeFrom": 11, "recoveryFrom": 16 },
    "5d": { "file": "res://Assets/Animations/ual2_standard.glb", "clip": "OverhandThrow", "activeFrom": 20, "recoveryFrom": 26 },
    "2a": { "file": "res://Assets/Animations/ual2_standard.glb", "clip": "Melee_Hook", "activeFrom": 13, "recoveryFrom": 18 },
    "2b": { "file": "res://Assets/Animations/ual2_standard.glb", "clip": "Sword_Regular_B", "activeFrom": 12, "recoveryFrom": 17 },
    "2c": { "file": "res://Assets/Animations/ual2_standard.glb", "clip": "Slide_Start", "activeFrom": 13, "recoveryFrom": 19 },
    "j_c": { "file": "res://Assets/Animations/ual1_standard.glb", "clip": "Sword_Attack", "activeFrom": 23, "recoveryFrom": 28 },
    // Rising arm swing: reach at 10, hips highest at 30.
    "623c": { "file": "res://Assets/Animations/ual2_standard.glb", "clip": "ClimbUp_1m", "activeFrom": 8, "recoveryFrom": 20 },
    // Hands pushed out at 32 (the clip's end), held through recovery.
    "236c": { "file": "res://Assets/Animations/ual1_standard.glb", "clip": "Spell_Simple_Enter", "activeFrom": 29, "recoveryFrom": 32 },
    "236236d": { "file": "res://Assets/Animations/ual2_standard.glb", "clip": "Sword_Dash", "activeFrom": 16, "recoveryFrom": 22 },
    "burst": { "file": "res://Assets/Animations/ual2_standard.glb", "clip": "Idle_Shield_Break", "activeFrom": 8, "recoveryFrom": 14 },
    // Shove: hands furthest out at 42.
    "forward_throw": { "file": "res://Assets/Animations/ual1_standard.glb", "clip": "Push", "loop": false, "clipTo": 70, "activeFrom": 38, "recoveryFrom": 44 },
    "back_throw": { "file": "res://Assets/Animations/ual2_standard.glb", "clip": "OverhandThrow", "activeFrom": 20, "recoveryFrom": 26 }
  },
  // How each projectile-throwing move's projectiles are drawn (ProjectileEffects): in flight, the startup charge at
  // the spawn point, and the impact where it hits, is blocked, clashes or runs out.
  "projectiles": {
    "236c": { "flight": "ice_orb", "charge": "ice_orb_charge", "impact": "ice_orb_impact" }
  },
  // Hit sparks (HitSparkLooks), one entry per hit: the way the attack travels in degrees from forward (90 up, -90
  // down), an offset in pixels, burst or tear, and a size. Moves left out get sparks from their hit data: light hits
  // burst forward, heavy hits and specials tear, launchers point along the launch.
  "sparks": {
    // Overhand: the arm comes down across the body.
    "5d": [{ "angle": -50, "style": "tear" }],
    // Air chop: straight down through the defender.
    "j_c": [{ "angle": -70 }],
    // Rising arm swing: up and away.
    "623c": [{ "angle": 65 }],
    // Slide: low along the floor.
    "2c": [{ "angle": 8, "offset": { "x": 0, "y": -10 } }],
    "236236d": [{ "angle": 15, "scale": 1.3 }]
  }
}
