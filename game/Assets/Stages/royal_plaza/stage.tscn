[node name="Stage" type="Node3D"]
editor_description = "Royal Plaza (stage 1, P4-D), from reference/royal_plaza_key_art_v2.png. source/build_layers.py cuts the floor texture and cards and prints their positions and sizes; re-run it and copy the numbers here when the key art or the fit changes. Folder rules: Stages/_template/README.md."

[node name="Lighting" type="Node3D" parent="."]
editor_description = "Key light, environment, fog, the stage's grade. The key light only casts the fighters' shadows on the painted floor (stage_projection_shadowed); it comes from the left but almost overhead, so each shadow pools under its fighter's feet."

[node name="KeyLight" type="DirectionalLight3D" parent="Lighting"]
transform = Transform3D(-0.4327311, 0.866112, -0.2501877, 0, 0.2775167, 0.9607208, 0.9015231, 0.4157337, -0.1200901, 0, 0, 0)
light_color = Color(1, 0.95, 0.86, 1)
shadow_enabled = true
directional_shadow_max_distance = 25.0

[node name="FighterStageLight" type="Node" parent="Lighting"]
editor_description = "The plaza's light on the fighters: soft daylight on their lit side, the blue sky in their shade and round their edges."
script = ExtResource("7_fighter_light")
LitTint = Color(1, 0.98, 0.95, 1)
ShadowTint = Color(0.86, 0.93, 1, 1)
Rim = Color(0.3, 0.42, 0.5, 1)

[node name="WorldEnvironment" type="WorldEnvironment" parent="Lighting"]
environment = SubResource("Environment_stage")

