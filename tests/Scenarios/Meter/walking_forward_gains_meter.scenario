# forwardGain (10) on every frame a fighter ends further forward; walking back gains nothing.
setup: p1 character scenario_dummy
setup: p2 character scenario_dummy
setup: module meter 5000 0 0 10 0 0
frames 1-20: p1 6
frames 1-20: p2 4

frame 20: expect module meter[0] > 100
frames 1-20: expect module meter[1] = 0
