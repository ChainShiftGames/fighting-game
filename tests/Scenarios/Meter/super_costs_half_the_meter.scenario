# Meter on, starting at 60 %: p1's 236236d comes out and costs 50 % (5000) on the frame it starts.
# Config: superCost hitGain blockGain forwardGain roundStartMeter carryOverRounds.
setup: p1 character testman
setup: p2 character testman
setup: module meter 5000 0 0 0 6000 0
frame 1: p1 2, 3, 6, 2, 3, 6d

frame 5: expect module meter[0] = 6000
frame 6: expect p1 move = 236236d
frame 6: expect module meter[0] = 1000
frame 6: expect module meter[1] = 6000
