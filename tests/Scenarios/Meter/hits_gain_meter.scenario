# The attacker gains hitGain (300) when 5a hits; the defender gains nothing.
setup: p1 character scenario_dummy
setup: p2 character scenario_dummy
setup: p1 x = -30000
setup: p2 x = 30000
setup: module meter 5000 300 150 0 0 0
frame 2: p1 5a

frame 6: expect p1 event hit
frame 6: expect module meter[0] = 300
frame 6: expect module meter[1] = 0
