# With 4000 meter the 5000 install can't be paid, so 214d starts nothing.
setup: p1 character mechanics_dummy
setup: p2 character scenario_dummy
setup: p1 x = -100000
setup: p2 x = 100000
setup: module meter 5000 0 0 0 4000 0
frame 1: p1 2, 1, 4d

frame 3: expect p1 move = idle
frame 3: expect module meter[0] = 4000
