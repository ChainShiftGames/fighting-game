# Testman, shipped air block (ground normals air-unblockable, mask 1): p2 jumps back holding back (airborne from
# frame 28) and blocks p1's 236c fireball in the air on frame 64, taking only its chip (60).
setup: module air_block 1
setup: p1 character testman
setup: p2 character testman
# The geometry below is Testman's long jump (jump velocity 20000); pinned so jump tuning in data/ can't move it.
setup: p2 stat jump_velocity 20000
# Room to back off: wider than the shipped screen.
setup: max_player_distance 640000
frame 1: p1 2, 3, 6c
frames 24-90: p2 7

frame 64: expect p2 state = air_blockstun
frame 64: expect p2 y > 0
frame 64: expect p2 damage = 60
frames 1-63: expect p2 damage = 0
