# Testman's 236c spawns its fireball on move frame 13 (frame 15), 45000 in front, flying 6000 per frame. From the
# round start distance it reaches p2's hurtbox on frame 51.
setup: p1 character testman
setup: p2 character testman

frame 1: p1 2, 3, 6c                     # 236c starts on frame 3

frame 3: expect p1 move = 236c
frame 14: expect p1 entities = 0
frame 15: expect p1 move_frame = 13
frame 15: expect p1 event projectile_spawn
frame 15: expect p1 entities = 1
frame 15: expect p1 entity_x = -105000   # -150000 + 45000
frame 16: expect p1 entity_x = -99000
frame 50: expect p2 damage = 0
frame 51: expect p1 event projectile_hit
frame 51: expect p1 entities = 0
frame 51: expect p2 damage = 600
frame 51: expect p2 state = hitstun
frame 51: expect p2 stun = 18
