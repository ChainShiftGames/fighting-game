# Testman's 236c spawns its fireball on move frame 33 (frame 35), 45000 in front, flying 13000 per frame. From the
# round start distance it reaches p2's hurtbox on frame 52.
setup: p1 character testman
setup: p2 character testman

frame 1: p1 2, 3, 6c                     # 236c starts on frame 3

frame 3: expect p1 move = 236c
frame 34: expect p1 entities = 0
frame 35: expect p1 move_frame = 33
frame 35: expect p1 event projectile_spawn
frame 35: expect p1 entities = 1
frame 35: expect p1 entity_x = -105000   # -150000 + 45000
frame 36: expect p1 entity_x = -92000
frame 51: expect p2 damage = 0
frame 52: expect p1 event projectile_hit
frame 52: expect p1 entities = 0
frame 52: expect p2 damage = 600
frame 52: expect p2 state = hitstun
frame 52: expect p2 stun = 18
