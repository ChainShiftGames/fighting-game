# Testman's run cancels into normals and specials, like a free fighter (dashStyle run).
setup: p1 character testman
setup: p2 character testman

frame 1: p1 6, 5, 6
frames 4-8: p1 6
frame 9: p1 6b
frames 3-8: expect p1 state = dash
frame 9: expect p1 state = attack
frame 9: expect p1 move = 5b

frame 1: p2 6, 5, 6
frames 4-6: p2 6
frame 7: p2 6, 2, 3c
frame 9: expect p2 move = 623c
