<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sim\Sim.csproj" />
    <ProjectReference Include="..\..\src\Sim.Data\Sim.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shown in the IDE; read from the source folder at run time, so editing a scenario needs no rebuild. -->
    <None Include="**\*.scenario" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scenario files and fixture data are read from the source tree; the real data/ folder from the repo root. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryRoot</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
