# throwVsStrike "throw" (the data default): p1's throw and p2's 5a both connect on frame 5. The throw grabs and the
# 5a is dropped. It also beats attack startup: a later 5a would simply be grabbed.
setup: p1 character scenario_dummy
setup: p2 character scenario_dummy
setup: p1 x = -30000
setup: p2 x = 30000

frame 1: p1 5a+b
frame 1: p2 5a

frame 5: expect p1 event throw_grab
frame 5: expect p2 event hit = 0
frame 5: expect p2 state = thrown
frames 1-10: expect p1 damage = 0
frame 10: expect p2 damage = 1200
