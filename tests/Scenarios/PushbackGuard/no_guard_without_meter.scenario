# With less meter than the cost the block is a normal one: normal pushback, no event.
setup: p1 character scenario_dummy
setup: p2 character scenario_dummy
setup: p1 x = -30000
setup: p2 x = 30000
setup: module meter 5000 0 0 0 100 0
setup: module pushback_guard 48 2 2000 200 0
frame 1: p1 5a
frames 5-21: p2 4a+b

frame 5: expect p2 event module = 0
frame 21: expect p2 x = 45200
