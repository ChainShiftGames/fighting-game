# In the corner the doubled pushback (24000) goes to p1 instead.
setup: p1 character scenario_dummy
setup: p2 character scenario_dummy
setup: p1 x = 520000
setup: p2 x = 580000
setup: module meter 5000 0 0 0 5000 0
setup: module pushback_guard 48 2 2000 200 0 1
frame 1: p1 5a
frames 5-21: p2 4a+b

frame 21: expect p1 x = 496000
frames 1-21: expect p2 x = 580000
