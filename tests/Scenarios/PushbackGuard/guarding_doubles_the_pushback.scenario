# p2 blocks p1's 5a holding back + a+b (the guard): 200 meter, and the slide is twice 5a's 12000. Holding a+b with
# back starts no throw. Compare Pushback/a_blocked_hit_pushes_the_defender_away: 45200 without the guard.
setup: p1 character scenario_dummy
setup: p2 character scenario_dummy
setup: p1 x = -30000
setup: p2 x = 30000
setup: module meter 5000 0 0 0 5000 0
setup: module pushback_guard 48 2 2000 200 0
frame 1: p1 5a
frames 5-21: p2 4a+b

frame 5: expect p2 state = blockstun
frame 5: expect p2 event module
frame 5: expect module meter[1] = 4800
frame 21: expect p2 x = 57200            # 33200 + 24000
