# Holding back + a+b is the guard, not a back throw (a quick tap that lets go still throws, from the buffer).
setup: p1 character scenario_dummy
setup: p2 character scenario_dummy
setup: p1 x = -30000
setup: p2 x = 30000
setup: module meter 5000 0 0 0 5000 0
setup: module pushback_guard 48 2 2000 200 0
frames 1-10: p2 4a+b

frames 1-10: expect p2 state != attack
