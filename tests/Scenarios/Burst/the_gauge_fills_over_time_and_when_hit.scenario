# From empty: +1 every frame of the round, and +300 for p2 when p1's 5a lands on it (frame 5).
setup: p1 character testman
setup: p2 character testman
setup: p1 x = -30000
setup: p2 x = 30000
setup: module burst 10000 0 1 300 10000 1 0 0 240 100
frame 1: p1 5a

frame 4: expect module burst[0] = 4
frame 4: expect module burst[2] = 4
frame 5: expect module burst[2] = 305
frame 5: expect module burst[0] = 5
