# The shipped setting: bursts only in hitstun, so the press while blocking does nothing.
setup: p1 character testman
setup: p2 character testman
setup: p1 x = -30000
setup: p2 x = 30000
setup: module burst 10000 10000 0 0 10000 1 0 0 240 34 100
frame 1: p1 5a
frames 5-6: p2 4
frame 7: p2 a+b+c+d

frame 7: expect module burst[3] = 0
frames 1-40: expect p2 move != burst
