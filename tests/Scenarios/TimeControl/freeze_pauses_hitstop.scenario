# Global freeze: counts down every frame; while it runs, a frozen fighter's hitstop is paused too.
setup: p1 character scenario_dummy
setup: p2 character scenario_dummy
setup: freeze = 3
setup: p1 hitstop = 2

frame 1: expect freeze = 2
frames 1-3: expect p1 hitstop = 2    # frozen: hitstop does not run
frames 3-6: expect freeze = 0
frame 4: expect p1 hitstop = 1
frames 5-6: expect p1 hitstop = 0
