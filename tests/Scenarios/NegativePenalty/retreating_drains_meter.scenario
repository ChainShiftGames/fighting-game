# penaltyFrames 30: after 30 frames walking back p1 loses meterLoss (2500) of its 5000 and gets the penalty event;
# the counter starts over. p2 stands still and keeps its meter.
setup: p1 character scenario_dummy
setup: p2 character scenario_dummy
setup: module meter 5000 0 0 0 5000 0
setup: module negative_penalty 30 2 2500
frames 1-40: p1 4

frame 30: expect p1 event module
frame 30: expect module meter[0] = 2500
frame 30: expect module negative_penalty[0] = 0
frames 1-29: expect module meter[0] = 5000
frames 1-40: expect module meter[1] = 5000
