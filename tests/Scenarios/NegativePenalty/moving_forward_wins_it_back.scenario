# 20 frames back, 10 forward (2 each: back to 0), 20 back again: never 30 in a row, so no penalty.
setup: p1 character scenario_dummy
setup: p2 character scenario_dummy
setup: module meter 5000 0 0 0 5000 0
setup: module negative_penalty 30 2 2500
frames 1-20: p1 4
frames 21-30: p1 6
frames 31-50: p1 4

frame 20: expect module negative_penalty[0] = 20
frame 30: expect module negative_penalty[0] = 0
frames 1-50: expect p1 event module = 0
frame 50: expect module meter[0] = 5000
