# Testman walking back with a 10-frame threshold (the shipped 180 would reach the screen edge first: about 12 frames
# from the round start, and a fighter stopped there isn't retreating): on frame 10 it loses a quarter of the gauge.
setup: module meter 5000 0 0 0 5000 0
setup: module negative_penalty 10 2 2500
setup: p1 character testman
setup: p2 character testman
frames 1-80: p1 4

frame 10: expect p1 event module
frame 10: expect module meter[0] = 2500
