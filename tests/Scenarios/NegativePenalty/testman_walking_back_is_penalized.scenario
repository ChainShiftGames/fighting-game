# Testman walking back with a 60-frame threshold (the shipped 180 would reach the wall first: about 134 frames from
# the round start, and a fighter stopped by the wall isn't retreating): on frame 60 it loses a quarter of the gauge.
setup: module meter 5000 0 0 0 5000 0
setup: module negative_penalty 60 2 2500
setup: p1 character testman
setup: p2 character testman
frames 1-80: p1 4

frame 60: expect p1 event module
frame 60: expect module meter[0] = 2500
