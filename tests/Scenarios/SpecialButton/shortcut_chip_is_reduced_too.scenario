# Blocked, the shortcut's chip damage is scaled as well: 100 → 50 at 50 %.
setup: p1 character scenario_dummy
setup: p2 character scenario_dummy
setup: p1 x = -30000
setup: p2 x = 30000
setup: shortcut_damage 50
frame 1: p1 6special
frames 1-20: p2 4

frame 12: expect p1 event block
frame 12: expect p2 damage = 50
