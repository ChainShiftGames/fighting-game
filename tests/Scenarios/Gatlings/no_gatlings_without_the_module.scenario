# Without the gatlings module, Testman's 5a data cancel window into 5b stays shut: B during 5a does nothing and
# 5a plays out its recovery (links only).
setup: p1 character testman
setup: p2 character testman
setup: p1 x = -30000
setup: p2 x = 30000

frame 1: p1 5a
frame 14: p1 5b

frame 5: expect p1 event hit
frame 14: expect p1 move = 5a
