# Testman's 5b window also allows a jump cancel (intoJump): holding up after it hits cancels its recovery into a
# prejump, so Testman is in the air long before 5b would have ended.
setup: module gatlings
setup: p1 character testman
setup: p2 character testman
setup: p1 x = -30000
setup: p2 x = 30000

frame 1: p1 5b
frames 8-25: p1 8

frame 7: expect p1 event hit
frame 25: expect p1 y > 0
