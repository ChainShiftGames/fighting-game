# Instant block (window 3, lockout 5, 3 frames off): p2 first presses back on frame 4 and blocks p1's 5a on frame 5,
# its second frame of back. Blockstun drops from 9 to 6 and p2 gets a module event, so it acts on frame 20
# instead of 23 (stand_block_high, frame_advantage_on_block).
setup: p1 character scenario_dummy
setup: p2 character scenario_dummy
setup: p1 x = -30000
setup: p2 x = 30000
setup: module instant_block 3 5 3

frame 1: p1 5a
frames 4-30: p2 4

frame 5: expect p1 event block
frame 5: expect p2 event module
frame 5: expect p2 state = blockstun
frame 5: expect p2 stun = 6
frames 6-30: expect p2 event module = 0
frames 5-30: expect p2 damage = 0
frame 19: expect p2 state = blockstun
frame 20: expect p2 state = walk_back
