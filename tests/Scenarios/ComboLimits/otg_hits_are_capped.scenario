# OTG rule, one hit per combo: 2a knocks p2 down, a second 2a hits it on the ground, a third whiffs.
setup: p1 character sparring_dummy
setup: p2 character sparring_dummy
setup: p1 x = -30000
setup: p2 x = 30000
setup: module combo_limits 0 0 0 0 0 0 0 1
frame 1: p1 2a
frame 10: p1 2a
frame 19: p1 2a

frame 3: expect p2 state = knockdown
frame 12: expect p1 event hit
frame 12: expect p2 damage = 2000
frame 21: expect p1 event hit = 0
frame 21: expect p2 damage = 2000
