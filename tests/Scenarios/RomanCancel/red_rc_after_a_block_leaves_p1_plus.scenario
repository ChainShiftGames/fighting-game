# Red Roman Cancel: p1's 5a is blocked on frame 5; a+b+c on frame 6 (in hitstop) spends 50 % and freezes the match
# for 6 frames. p1 leaves its own hitstop at once and is idle when the freeze ends, while p2 still has its hitstop and
# blockstun to sit through at half speed: p1 is plus. The RC buttons start no attack.
setup: p1 character scenario_dummy
setup: p2 character scenario_dummy
setup: p1 x = -30000
setup: p2 x = 30000
setup: module meter 5000 0 0 0 10000 0
setup: module roman_cancel 112 3 3 5000 15 6 40 1 2
frame 1: p1 5a
frames 1-40: p2 4
frame 6: p1 5a+b+c

frame 6: expect p1 event module
frame 6: expect module meter[0] = 5000
frame 6: expect freeze > 0
frame 12: expect p1 state = idle
frame 12: expect p2 state = blockstun
frame 24: expect p2 state = blockstun
frames 12-24: expect p1 state != attack
