# Testman, shipped Roman Cancel (a+b+c, 50 %, 6-frame freeze, half speed for 40 frames): 5a blocked, RC on frame 6,
# p1 idle on frame 12 while p2 is still in blockstun.
setup: module meter 5000 0 0 0 10000 0
setup: module roman_cancel 112 3 3 5000 15 6 40 1 2
setup: p1 character testman
setup: p2 character testman
setup: p1 x = -30000
setup: p2 x = 30000
frame 1: p1 5a
frames 5-40: p2 4
frame 6: p1 5a+b+c

frame 6: expect p1 event module
frame 12: expect p1 state = idle
frame 12: expect p2 state = blockstun
