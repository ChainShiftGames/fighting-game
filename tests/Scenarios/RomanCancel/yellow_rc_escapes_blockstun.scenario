# Yellow Roman Cancel: p2, blocking p1's 5a, cancels its blockstun on frame 14 and is free right after the freeze,
# long before the blockstun would have ended. It doesn't slow p1.
setup: p1 character scenario_dummy
setup: p2 character scenario_dummy
setup: p1 x = -30000
setup: p2 x = 30000
setup: module meter 5000 0 0 0 10000 0
setup: module roman_cancel 112 3 3 5000 15 6 40 1 2
frame 1: p1 5a
frames 1-13: p2 4
frame 14: p2 a+b+c

frame 14: expect p2 event module
frame 14: expect module meter[1] = 5000
frame 20: expect p2 state != blockstun
