# After a red Roman Cancel, a 5a pressed during the freeze (frame 11) is buffered and starts the moment p1 runs
# again, on frame 12, while p2 is still stuck in blockstun: a frame trap the RC made.
setup: p1 character scenario_dummy
setup: p2 character scenario_dummy
setup: p1 x = -30000
setup: p2 x = 30000
setup: module meter 5000 0 0 0 10000 0
setup: module roman_cancel 112 3 3 5000 15 6 40 1 2
frame 1: p1 5a
frames 1-40: p2 4
frame 6: p1 5a+b+c
frame 11: p1 5a

frame 12: expect p1 move = 5a
frame 12: expect p1 move_frame = 1
frame 12: expect p2 state = blockstun
