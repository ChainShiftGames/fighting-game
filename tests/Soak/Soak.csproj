<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bot soak test (P2-12, ADR-0006): two in-process online peers for an hour. A console app, not a test project,
       so `dotnet test` never runs it; the manual "Soak test" workflow does. Usage: Program.cs / SoakOptions.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Netcode\Netcode.csproj" />
    <ProjectReference Include="..\..\src\Sim\Sim.csproj" />
    <ProjectReference Include="..\..\src\Sim.Data\Sim.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared with the Netcode tests rather than copied: the same in-memory transport pair the online tests use.
         The players are CPU bots from Netcode.Bots (P3-50). -->
    <Compile Include="..\Netcode.Tests\Transport\InMemoryTransport.cs" Link="Shared\InMemoryTransport.cs" />
    <Compile Include="..\Netcode.Tests\Transport\OpenedTransport.cs" Link="Shared\OpenedTransport.cs" />
  </ItemGroup>
</Project>
